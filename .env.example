# Research pipeline settings (scripts/pipeline). Copy to .env (gitignored) and fill in.
# Run steps with: node --env-file=.env scripts/pipeline/<step>.mjs --estimate

# Anthropic API key for discovery and research (steps 03 and 05).
ANTHROPIC_API_KEY=

# Optional: hard spending cap in US dollars across all batches (default 90).
BUDGET_USD=

# Optional: which metro to work on (see scripts/pipeline/metros.mjs).
METRO=

# Optional: a different Overpass API endpoint for step 01.
OVERPASS_URL=
