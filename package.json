{
  "name": "the-unlisted",
  "type": "module",
  "version": "2.1.0",
  "description": "A hand-picked guide to independent food and drink in the Bay Area, San Diego and Portland, researched with AI and reviewed by a person.",
  "author": "Dan West (https://www.icarianforge.com)",
  "license": "UNLICENSED",
  "homepage": "https://unlisted.icarianforge.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/lautbzehn/the-unlisted.git"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "node --test \"worker/__tests__/*.test.js\"",
    "astro": "astro",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "postbuild": "node scripts/csp.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cities": "node scripts/cities.mjs",
    "inbox": "node scripts/inbox.mjs",
    "subscribers": "node scripts/subscribers.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.4",
    "maplibre-gl": "^6.16.0",
    "motion": "^14.7.1",
    "satori": "0.35.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "wrangler": "^4.155.0"
  },
  "overrides": {
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
