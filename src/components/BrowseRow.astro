---
// A front-page row: a heading and a grid of tickets drawn on hairline rails, with a pointer spotlight and corner
// crosshairs (home.css). Phones get the same tickets as a sideways strip. Each ticket's Gem score is a cold bar
// that fills in as it scrolls into view (scripts/home.js).
import { FAME, whereText } from '../lib/places.js';
import { stubCode } from '../lib/mrz.js';
import Score from './Score.astro';
interface Props {
  id: string; title: string; kicker?: string; sub?: string; places: any[]; total: number; seeAll: string;
  max?: number; keep?: number; hidden?: boolean; bucket?: string;
}
// A few extra are sent so the page can skip places another row already shows and still fill the grid.
// `keep` is how many show (home.css hides the rest), so skipping one never changes the row's height.
const { id, title, kicker, sub, places, total, seeAll, max = 10, keep = 8, hidden = false, bucket } = Astro.props;
const shown = places.slice(0, max);
---
<section class="browse" aria-labelledby={`${id}-h`} hidden={hidden} data-bucket={bucket}>
  <div class="row-head">
    {kicker && <p class:list={['kicker mono', { live: bucket }]} data-kicker>{kicker}</p>}
    <h2 id={`${id}-h`}>{title}</h2>
    {sub && <p class="row-sub">{sub}</p>}
    <a class="more-link" href={seeAll}>See all {total}<span class="sr-only"> {title.toLowerCase()}</span> <span aria-hidden="true">→</span></a>
  </div>
  <div class="rails" data-spotlight>
    <ul class="rail-grid" role="list" data-row data-keep={keep} style={`--keep:${keep}`}>
      {shown.map((p) => (
        <li>
          <a class="ticket cell" href={`/place/${p.id}/`} data-id={p.id} data-status="none">
            <span class="cell-top mono" aria-hidden="true"><span class="cell-n"></span>{p.fame && <span>{FAME[p.fame]}</span>}</span>
            <span class="cell-name">{p.name}</span>
            <span class="cell-meta">{whereText(p)}</span>
            <span class="cell-line">{p.tagline}</span>
            <Score score={p.score} />
            <span class="t-foot">
              {p.fame && <span class="sr-only">{FAME[p.fame]}</span>}
              {p.draft && <span class="t-draft">Draft</span>}
              <span class="t-status"></span>
            </span>
            <span class="t-stub mono" aria-hidden="true">{stubCode(p)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
