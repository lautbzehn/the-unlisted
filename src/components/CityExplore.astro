---
// One city's Explore page (Bay Area at /explore/, San Diego at /san-diego/explore/).
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import PlaceCard from './PlaceCard.astro';
import MapSheet from './MapSheet.astro';
import CitySwitch from './CitySwitch.astro';
import { METROS, placesIn, slim, TYPES, FAME, WHEN, whereGroups } from '../lib/places.js';
import { LISTS, PIN_TIPS } from '../lib/glossary.js';

interface Props { metro: string }
const M = METROS[Astro.props.metro];
const places = placesIn(M.id);
const FAME_PLURAL = { 'deep-cut': 'Deep cuts', 'open-secret': 'Open secrets', 'local-legend': 'Local legends' };
---
<Base title={M.id === 'bay-area' ? 'Explore — The Unlisted' : `Explore ${M.name} — The Unlisted`} description={`Every door in ${M.the}. Search, filter by time of day, kind of place and neighborhood, or see them all on a map.`} path={M.explore} metro={M.id}>
  <main id="main" class="explore" data-view="cards" data-metro={M.id}>
    <header class="page-head">
      <CitySwitch current={M.id} to="explore" />
      <h1 class="page-title">Explore</h1>
      <p class="page-sub">Every door in {M.the}, {places.length} so far. Open one for the story and what to order.</p>
    </header>

    <div class="finder">
      <div class="find-row">
        <label class="sr-only" for="q">Search places</label>
        <input id="q" type="search" placeholder="Search dishes or places" autocomplete="off" enterkeyhint="search" />
        <button class="btn filters-toggle" type="button" aria-expanded="false" aria-controls="filters">Filters<span class="fcount" data-fcount hidden></span></button>
      </div>
      <div class="filters" id="filters">
        <label>When
          <select data-f="time">
            <option value="any" data-label="Any time">Any time</option>
            <option value="now" data-label="Right now">Right now</option>
            {Object.entries(WHEN).map(([v, l]) => <option value={v} data-label={l}>{l}</option>)}
          </select>
        </label>
        <label>Kind of place
          <select data-f="type">
            <option value="" data-label="Any kind">Any kind</option>
            {Object.entries(TYPES).map(([v, l]) => <option value={v} data-label={l}>{l}</option>)}
          </select>
        </label>
        <label>Where
          <select data-f="where">
            <option value="" data-label="Anywhere">Anywhere</option>
            {whereGroups(places, M.more).map((g) => (
              <optgroup label={g.label}>
                {g.options.map((o) => <option value={o.value} data-label={o.label}>{o.label}</option>)}
              </optgroup>
            ))}
          </select>
        </label>
        <label>How well-known
          <select data-f="fame">
            <option value="" data-label="Any">Any</option>
            {Object.keys(FAME).map((v) => <option value={v} data-label={FAME_PLURAL[v]}>{FAME_PLURAL[v]}</option>)}
          </select>
        </label>
        <label>Sort by
          <select data-f="sort">
            <option value="score">Top Gem score</option>
            <option value="name">Name, A to Z</option>
            <option value="near">Nearest to me</option>
          </select>
        </label>
      </div>
      <p class="result-line"><span data-result role="status"></span><button class="btn-text" type="button" data-clear hidden>Clear filters</button></p>
    </div>

    <div class="explore-split">
      <div class="list-col">
        <p class="empty" id="empty"></p>
        <div class="entries" id="entries">
          {places.map((p) => <PlaceCard place={p} />)}
        </div>
        <button class="btn more-btn" type="button" data-more hidden>Show more</button>
        <p class="suggest-cta">Know a place that belongs here? <a href="/suggest/">Suggest it</a></p>
      </div>
      <div class="map-col">
        <div id="map" data-center={JSON.stringify(M.center)} data-zoom={M.zoom} role="region" aria-label="Map of the places in the list. Use the pins, or the list for the same places."></div>
        <ul class="legend" aria-hidden="true">
          <li><span class="swatch" data-status="none"></span>{PIN_TIPS.none}</li>
          <li><span class="swatch" data-status="knock"></span>{LISTS.bucket.name}</li>
          <li><span class="swatch" data-status="ledger"></span>{LISTS.stamped.name}</li>
        </ul>
      </div>
    </div>

    <div class="views" role="group" aria-label="View">
      <button type="button" data-view="cards" aria-pressed="true">List</button>
      <button type="button" data-view="map" aria-pressed="false">Map</button>
    </div>

    <MapSheet />
    <script type="application/json" id="places-data" set:html={JSON.stringify(slim(places))} />
  </main>
  <Footer sample={places.some((p) => p.sample)} />

  <script>
    import '../scripts/explore.js';
  </script>
</Base>
