---
// One city's front page (Bay Area at /, San Diego at /san-diego/, Portland at /portland/).
import Base from '../layouts/Base.astro';
import Footer from './Footer.astro';
import BrowseRow from './BrowseRow.astro';
import StackRow from './StackRow.astro';
import SurpriseDialog from './SurpriseDialog.astro';
import Gate from './Gate.astro';
import CitySwitch from './CitySwitch.astro';
import { METROS, placesIn, slim, topHoods } from '../lib/places.js';
import { mrzPart } from '../lib/mrz.js';
import '../styles/home.css';

interface Props { metro: string }
const M = METROS[Astro.props.metro];
const places = placesIn(M.id);
const MIN = 3; // a row needs at least this many places to be worth showing
const by = (f) => places.filter(f);
const NOW_ROWS = [
  { bucket: 'morning', title: 'Morning doors', sub: 'Coffee, pastries and breakfast counters that open early.' },
  { bucket: 'midday', title: 'Lunch doors', sub: 'Counters and kitchens worth the detour at lunch.' },
  { bucket: 'evening', title: 'Dinner doors', sub: 'Where to eat tonight.' },
  { bucket: 'late', title: 'Late-night doors', sub: 'Usually open past 10. Check before you go.' },
].map((r) => ({ ...r, list: by((p) => p.when?.includes(r.bucket)) })).filter((r) => r.list.length >= MIN);
// The second row: deep cuts once there are enough of them, local legends until then.
const deep = by((p) => p.fame === 'deep-cut');
const second = deep.length >= MIN
  ? { id: 'deep', title: 'Deep cuts', head: 'Barely written about anywhere.', sub: 'You heard it from someone, not a website.', list: deep, fame: 'deep-cut' }
  : { id: 'legends', title: 'Local legends', head: 'Decades in, still the real thing.', list: by((p) => p.fame === 'local-legend'), fame: 'local-legend' };
const hoods = topHoods(places, 12);
// The hero's fine print: where we are, and a passport code line that crawls along the bottom edge.
const [lng, lat] = M.center;
const coords = `${Math.abs(lat).toFixed(2)}° ${lat >= 0 ? 'N' : 'S'}  ${Math.abs(lng).toFixed(2)}° ${lng >= 0 ? 'E' : 'W'}`;
const mrzLine = `P<UNL<<${mrzPart(M.name)}<<${places.length}<DOORS<<NO<CHAINS<<NO<ALGORITHM<<HUMAN<CURATED<<`;
const TITLE = ['The', 'Unlisted'];
---
<Base title={`The Unlisted — ${M.name} hole-in-the-wall guide`} description={`${M.name} hole-in-the-wall guide. No chains, no algorithm.`} path={M.home} metro={M.id}>
  <Gate />
  <main id="main" class="home" data-metro={M.id} data-short={M.short} data-explore={M.explore}>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-bg" aria-hidden="true"><canvas class="grain" data-grain></canvas></div>
      <div class="hero-top">
        <CitySwitch current={M.id} />
        <p class="hero-meta mono" aria-hidden="true"><span>{coords}</span><span class="hero-clock" data-hero-clock></span></p>
      </div>
      <h1 class="hero-title" id="hero-title" aria-label="The Unlisted">
        {TITLE.map((word, w) => (
          <span class:list={['word', `w${w}`]} aria-hidden="true">{[...word].map((ch, i) => <span class="ch" style={`--i:${i + w * 3}`}>{ch}</span>)}</span>
        ))}
      </h1>
      <div class="hero-foot">
        <div class="hero-copy">
          <p class="tagline">Places you only hear about from the cousin who knows a guy. <strong><span class="ul">Now you know a guy.</span></strong></p>
          <p class="flipper" id="flipper" aria-hidden="true"><span class="mono" data-flip-label>Tonight’s doors:</span> <span class="w"><span>&nbsp;</span></span></p>
        </div>
        <div class="cover-cta">
          <button id="surprise-btn" class="btn btn-primary btn-lg" type="button">Surprise me</button>
          <a class="btn btn-lg btn-ghost" href={M.explore}>Explore all {places.length}</a>
        </div>
      </div>
      <div class="hero-mrz mono" aria-hidden="true"><span>{mrzLine.repeat(4)}</span><span>{mrzLine.repeat(4)}</span></div>
    </section>

    <SurpriseDialog />

    {NOW_ROWS.map((r) => (
      <BrowseRow id={`now-${r.bucket}`} bucket={r.bucket} kicker="Right now" title={r.title} sub={r.sub}
        places={r.list} total={r.list.length} seeAll={`${M.explore}?time=${r.bucket}`} hidden />
    ))}
    <noscript><style>.browse[data-bucket='midday'] { display: block !important; }</style></noscript>
    <script is:inline>
      // Show this hour's row before the first paint, so nothing below it jumps (the same hours as scripts/time.js)
      (() => {
        const tz = { timeZone: 'America/Los_Angeles' }, d = new Date();
        const h = Number(new Intl.DateTimeFormat('en-US', { hour: 'numeric', hourCycle: 'h23', ...tz }).format(d));
        const b = h >= 5 && h < 11 ? 'morning' : h >= 11 && h < 17 ? 'midday' : h >= 17 && h < 22 ? 'evening' : 'late';
        const row = document.querySelector('.browse[data-bucket="' + b + '"]');
        if (!row) return;
        const clock = new Intl.DateTimeFormat('en-US', { hour: 'numeric', minute: '2-digit', ...tz }).format(d);
        row.querySelector('[data-kicker]').textContent = 'Right now · ' + clock + ' in ' + document.getElementById('main').dataset.short;
        row.hidden = false;
      })();
    </script>

    {second.list.length >= MIN && (
      <StackRow id={second.id} kicker={second.title} title={second.head} sub={second.sub} places={second.list} total={second.list.length} seeAll={`${M.explore}?fame=${second.fame}`} />
    )}

    <section class="browse hoods" aria-labelledby="by-hood">
      <div class="row-head">
        <p class="kicker mono">Neighborhoods</p>
        <h2 id="by-hood">Pick a neighborhood</h2>
        <a class="more-link" href={M.explore}>All of them <span aria-hidden="true">→</span></a>
      </div>
      <div class="rails" data-spotlight>
        <ul class="rail-grid hood-grid" role="list">
          {hoods.map((h) => (
            <li><a class="cell hood" href={`${M.explore}?where=${h.where}`}><span class="hood-name">{h.label}{h.city !== M.main && h.city !== h.label && `, ${h.city}`}</span><span class="n mono">{String(h.n).padStart(2, '0')}<span class="sr-only"> places</span></span></a></li>
          ))}
        </ul>
      </div>
    </section>

    <section class="next-cities" aria-label="Next cities">
      <p class="kicker mono">Coming up</p>
      <p class="next-line"><strong>Next stamps in the passport:</strong> Austin and New York.</p>
      <a class="btn btn-lg" href="/cities/">Vote for the one after <span aria-hidden="true">→</span></a>
    </section>

    <script type="application/json" id="places-data" set:html={JSON.stringify(slim(places))} />
  </main>
  <Footer sample={places.some((p) => p.sample)} />

  <script>
    import '../scripts/home.js';
    import '../scripts/gate.js';
  </script>
</Base>
