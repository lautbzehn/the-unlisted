---
// Welcome gate ("passport control"). Shown once, on a first visit to the front page; the check runs in
// Base.astro before the page paints, so returning visitors never see a flash of it. Shared links skip it.
import { GATE_VIDEO } from '../lib/config.js';
---
<div class="gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title" aria-describedby="gate-sub">
  {GATE_VIDEO && (
    <video class="gate-video" src={GATE_VIDEO.src} poster={GATE_VIDEO.poster} muted playsinline loop preload="metadata" aria-hidden="true"></video>
  )}
  <div class="gate-frame">
    <span class="orn tl" aria-hidden="true"></span><span class="orn tr" aria-hidden="true"></span>
    <span class="orn bl" aria-hidden="true"></span><span class="orn br" aria-hidden="true"></span>
    <span class="flourish top" aria-hidden="true"></span><span class="flourish bottom" aria-hidden="true"></span>
    <p class="gate-eyebrow">Passport control</p>
    <div class="gate-crest" aria-hidden="true">U</div>
    <h2 class="logo" id="gate-title">The Unlisted</h2>
    <p class="gate-line">Not everything gets in.<br />Consider yourself vouched for.</p>
    <p class="gate-sub" id="gate-sub">A hand-picked list of the best-kept counters, diners, bakeries and bars in the Bay Area and San Diego. No chains, no influencers, no reservations. Just the places locals only tell their friends about.</p>
    <button class="btn btn-primary btn-lg" type="button" id="gate-enter">Stamp me in</button>
    <p class="gate-pass">Password? Tell them a guy sent you.</p>
    <p class="gate-fine">Admit one · Bay Area · San Diego · All hours · No. 0001</p>
    <p class="gate-maker">An <span class="ifp"><b>I</b>carian <b>Forge</b></span> product</p>
    <div class="gate-stamp" aria-hidden="true">Admitted</div>
  </div>
</div>
