---
// Welcome gate ("passport control"). Shown once, on a first visit to the front page; the check runs in
// Base.astro before the page paints, so returning visitors never see a flash of it. Shared links skip it.
import { GATE_VIDEO } from '../lib/config.js';
---
<div class="gate" id="gate" role="dialog" aria-modal="true" aria-labelledby="gate-title" aria-describedby="gate-sub">
  {GATE_VIDEO && (
    <video class="gate-video" src={GATE_VIDEO.src} poster={GATE_VIDEO.poster} muted playsinline loop preload="metadata" aria-hidden="true"></video>
  )}
  <div class="gate-inner">
    <p class="gate-eyebrow">Passport control</p>
    <div class="gate-crest" aria-hidden="true">U</div>
    <h2 class="logo" id="gate-title">The Unlisted</h2>
    <p class="gate-line">Not everything gets in.</p>
    <p class="gate-sub" id="gate-sub">A short, hand-picked list of the Bay Area’s hole-in-the-wall counters, diners, bakeries and bars. The places locals keep to themselves.</p>
    <button class="btn btn-primary btn-lg" type="button" id="gate-enter">Stamp me in</button>
    <p class="gate-fine">Bay Area · All hours · No. 0001</p>
    <div class="gate-stamp" aria-hidden="true">Admitted</div>
  </div>
</div>
