---
import { NAV, sectionFor } from '../lib/nav.js';
const current = sectionFor(Astro.url.pathname);
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label="The Unlisted, home"><b>The Unlisted</b><small>No. 0001</small></a>
    <nav class="nav" aria-label="Main">
      {NAV.map((g) => (
        <div class:list={['nav-group', { current: g.id === current }]}>
          <button type="button" aria-expanded="false" aria-controls={`menu-${g.id}`}>{g.label}</button>
          <ul class="menu" id={`menu-${g.id}`} hidden>
            {g.items.map((it) => <li><a href={it.href}>{it.label}<small>{it.hint}</small></a></li>)}
          </ul>
        </div>
      ))}
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
  </div>
</header>
<!-- Outside the header on purpose: the header's blur would otherwise trap this full-screen menu inside it. -->
<div class="mobile-menu" id="mobile-menu" hidden>
  {NAV.map((g) => (
    <section>
      <h2>{g.label}</h2>
      <ul>{g.items.map((it) => <li><a href={it.href}>{it.label}<small>{it.hint}</small></a></li>)}</ul>
    </section>
  ))}
  </div>

<script>
  // Dropdowns: open on click or hover (desktop), close on outside click, Escape, or picking a link.
  const groups = [...document.querySelectorAll('.nav-group')];
  const close = (except) => groups.forEach((g) => {
    if (g === except) return;
    g.querySelector('button').setAttribute('aria-expanded', 'false');
    g.querySelector('.menu').hidden = true;
  });
  const open = (g) => { close(g); g.querySelector('button').setAttribute('aria-expanded', 'true'); g.querySelector('.menu').hidden = false; };
  const hoverable = matchMedia('(hover: hover)').matches;
  for (const g of groups) {
    const btn = g.querySelector('button');
    btn.addEventListener('click', () => (btn.getAttribute('aria-expanded') === 'true' ? close() : open(g)));
    if (hoverable) {
      let t;
      g.addEventListener('mouseenter', () => { clearTimeout(t); open(g); });
      g.addEventListener('mouseleave', () => { t = setTimeout(() => close(), 180); });
    }
  }
  document.addEventListener('click', (e) => { if (!e.target.closest('.nav-group')) close(); });

  // Phone menu
  const toggle = document.querySelector('.menu-toggle');
  const sheet = document.getElementById('mobile-menu');
  const setSheet = (on) => {
    sheet.hidden = !on;
    toggle.setAttribute('aria-expanded', String(on));
    toggle.textContent = on ? 'Close' : 'Menu';
    document.documentElement.style.overflow = on ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setSheet(sheet.hidden));
  sheet.addEventListener('click', (e) => { if (e.target.closest('a')) setSheet(false); });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    close();
    if (!sheet.hidden) { setSheet(false); toggle.focus(); }
  });
</script>
