---
import { NAV, ABOUT, sectionFor } from '../lib/nav.js';
const current = sectionFor(Astro.url.pathname);
const here = (href) => (Astro.url.pathname === href ? 'page' : undefined);
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label="The Unlisted, home">The Unlisted</a>
    <nav class="nav" aria-label="Main">
      {NAV.map((it) => (
        <a href={it.href} aria-current={it.id === current ? 'page' : undefined}>
          {it.label}{it.id === 'passport' && <span class="count" data-passport-count hidden></span>}
        </a>
      ))}
    </nav>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">Menu</button>
  </div>
</header>
<!-- Outside the header on purpose: the header's blur would otherwise trap this full-screen menu inside it. -->
<nav class="mobile-menu" id="mobile-menu" aria-label="Menu" hidden>
  <ul class="mm-main">
    <li><a href="/" aria-current={here('/')}>Home</a></li>
    {NAV.map((it) => (
      <li><a href={it.href} aria-current={it.id === current ? 'page' : undefined}>{it.label}{it.id === 'passport' && <span class="count" data-passport-count hidden></span>}</a></li>
    ))}
  </ul>
  <ul class="mm-more">
    {ABOUT.slice(1).map((it) => <li><a href={it.href} aria-current={here(it.href)}>{it.label}</a></li>)}
    <li><button type="button" data-signup="footer">Get email updates</button></li>
  </ul>
</nav>

<script>
  // Phone menu
  const toggle = document.querySelector('.menu-toggle');
  const sheet = document.getElementById('mobile-menu');
  const setSheet = (on) => {
    sheet.hidden = !on;
    toggle.setAttribute('aria-expanded', String(on));
    toggle.textContent = on ? 'Close' : 'Menu';
    document.documentElement.style.overflow = on ? 'hidden' : '';
  };
  toggle.addEventListener('click', () => setSheet(sheet.hidden));
  sheet.addEventListener('click', (e) => { if (e.target.closest('a, button')) setSheet(false); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !sheet.hidden) { setSheet(false); toggle.focus(); }
  });

  // How many places are in your passport, next to "My Passport". Read straight from this device's storage.
  const paintCount = () => {
    let n = 0;
    try { n = Object.values(JSON.parse(localStorage.getItem('unlisted:v1')) || {}).filter((s) => s.status).length; } catch {}
    document.querySelectorAll('[data-passport-count]').forEach((el) => { el.hidden = !n; el.textContent = n; });
  };
  paintCount();
  addEventListener('storage', paintCount);
  addEventListener('passport:change', paintCount);
</script>
