---
// A place's name as a neon sign: its own visual, generated from its id (lib/neon.js) so it never changes
// between visits. Real text, so it reads and selects like any heading. Styles in components.css (.neon).
import { neonFor } from '../lib/neon.js';
interface Props { id: string; name: string; tag?: string }
const { id, name, tag = 'span' } = Astro.props;
const { tone, face, tilt, flicker: at } = neonFor(id, name);
const chars = [...name];
const Tag = tag;
---
<Tag class="neon" data-tone={tone} data-face={face} style={`--tilt:${tilt}deg;--len:${chars.length}`}>
  {at < 0 ? name : <>{chars.slice(0, at).join('')}<span class="flick">{chars[at]}</span>{chars.slice(at + 1).join('')}</>}
</Tag>
