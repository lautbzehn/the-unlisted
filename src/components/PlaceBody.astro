---
// Everything below a place's name, shared by the Explore entry and the place's own page.
import { MARKS } from '../lib/scoring.js';
import { MARK_TIPS, LISTS } from '../lib/glossary.js';
import { whenText } from '../lib/places.js';
const { place, google, mrz, detail = false } = Astro.props;
const when = whenText(place.when);
---
<p class="story">{place.story}</p>
<p class="order"><b>Order</b>{place.order}</p>
{!detail && <p class="facts">{[when, place.kind].filter(Boolean).join(' · ')}</p>}
{detail && (place.practical?.length || place.hours) && (
  <ul class="practical">
    {place.practical?.map((x) => <li>{x}</li>)}
    {place.hours && <li>Hours: {place.hours}</li>}
  </ul>
)}
{detail && <p class="verified">Last checked {place.verified}. Hours change, so check before you go.</p>}
<div class="actions">
  <button class="btn btn-primary" data-action="ledger" aria-pressed="false" data-tip={detail ? LISTS.stamped.tip : undefined}>Stamp it</button>
  <button class="btn" data-action="knock" aria-pressed="false" data-tip={detail ? LISTS.bucket.tip : undefined}>+ Bucket List</button>
  <span class="stamp-mark" aria-hidden="true">Stamped<small data-stamp-date>The Unlisted</small></span>
</div>
<div class="links">
  <button type="button" data-action="map">Map</button>
  <button type="button" data-action="share">Share</button>
  <a href={google} target="_blank" rel="noopener">Google Maps ↗</a>
  {!detail && <a href={`/place/${place.id}/`}>Full page →</a>}
</div>
<div class="ledger">
  <div class="cap"><span>Your rating</span><span data-strike-label>Not rated</span></div>
  <div class="strikes" role="group" aria-label={`Your rating for ${place.name}`}>
    {[1, 2, 3, 4, 5].map((n) => (
      <button class="strike" data-strike={n} data-on="false" aria-label={`${n} of 5 stamps`} aria-pressed="false">
        <svg viewBox="0 0 30 30" aria-hidden="true"><circle cx="15" cy="15" r="12" /></svg>
      </button>
    ))}
  </div>
  <label class="sr-only" for={`note-${place.id}`}>Private note</label>
  <textarea id={`note-${place.id}`} data-note placeholder="Private note: what you ordered, who to ask for…" maxlength="400"></textarea>
</div>
{detail && (
  <section class="marks-box" aria-labelledby={`marks-${place.id}`}>
    <h2 id={`marks-${place.id}`}>How it scored</h2>
    {MARKS.map((m) => (
      <div class="mark-row" data-tip={MARK_TIPS[m.key]}><span>{m.label}</span><div class="bar" style={`--w:${place.breakdown[m.key]}%`} aria-hidden="true"></div><b>{place.breakdown[m.key]}</b></div>
    ))}
    <a class="more-link" href="/how-the-score-works/">How the score works →</a>
  </section>
)}
{detail && place.reviewFlags?.length > 0 && (
  <div class="review-flags"><strong>Check before approving</strong><ul>{place.reviewFlags.map((f) => <li>{f}</li>)}</ul></div>
)}
{detail && <div class="mrz" aria-hidden="true">{mrz}</div>}
