---
// What opens under a place's name in an Explore list (and on My Passport). The place's own page has its own
// layout (PlaceCard, variant 'detail') and shares the controls (PlaceActions).
import PlaceActions from './PlaceActions.astro';
import { whenText } from '../lib/places.js';
const { place, google } = Astro.props;
const when = whenText(place.when);
---
<p class="story">{place.story}</p>
<p class="order"><b class="mono">Order</b>{place.order}</p>
<p class="facts">{[when, place.kind].filter(Boolean).join(' · ')}</p>
<PlaceActions place={place} google={google} />
