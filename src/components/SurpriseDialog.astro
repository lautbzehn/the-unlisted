<!-- Surprise me: the pop-up that reveals one place. Filled in by src/scripts/surprise.js. -->
<dialog id="surprise" aria-labelledby="sp-title">
  <div class="sp-card">
    <button class="sp-x" data-sp="close" aria-label="Close">×</button>
    <div class="sp-kicker">TODAY'S DOOR</div>
    <div class="sp-slot" data-sp="slot" aria-hidden="true"></div>
    <div class="sp-body">
      <div class="stamp" aria-hidden="true"><small>GEM</small><b data-sp="score"></b><i>VISA</i></div>
      <span class="sample-flag" data-sp="sample">SAMPLE — NOT A REAL PLACE</span>
      <h2 id="sp-title"></h2>
      <div class="meta" data-sp="meta"></div>
      <p data-sp="story"></p>
      <p class="order"><em>Order</em><span data-sp="order"></span></p>
      <p class="sp-where" data-sp="where"></p>
      <div class="sp-actions">
        <a class="btn-primary" data-sp="open" href="#">Open the file →</a>
        <a class="btn-ghost" data-sp="directions" href="#" target="_blank" rel="noopener">Directions</a>
        <button class="btn-ghost" data-sp="knock" aria-pressed="false">+ Bucket List</button>
        <button class="btn-ghost" data-sp="map">Show on map</button>
        <button class="btn-ghost" data-sp="again">Another one</button>
      </div>
    </div>
  </div>
</dialog>
