<!-- Surprise me: a small deck of places to swipe through. Filled in by src/scripts/surprise.js. -->
<dialog id="surprise" class="modal deck-modal" aria-labelledby="sp-title">
  <div class="modal-card">
    <button class="modal-x" type="button" data-sp="close" aria-label="Close">×</button>
    <p class="eyebrow" data-sp="kicker">Right now</p>
    <h2 id="sp-title">Swipe the deck</h2>
    <div class="deck" data-sp="deck" tabindex="0" role="group" aria-roledescription="card stack" aria-label="Places to try" aria-describedby="sp-hint"></div>
    <div class="deck-ctl">
      <button class="btn" type="button" data-sp="pass">✕ <span data-sp="pass-label">Not tonight</span></button>
      <button class="btn" type="button" data-sp="undo" aria-label="Undo">↺</button>
      <button class="btn btn-primary" type="button" data-sp="keep">✓ Bucket List</button>
    </div>
    <p class="deck-hint" id="sp-hint">Drag a card, or use ← and → on the keyboard. Right adds it to your Bucket List.</p>
    <p class="sr-only" role="status" aria-live="polite" data-sp="msg"></p>
  </div>
</dialog>
