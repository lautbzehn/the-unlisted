---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Bay Area hole-in-the-wall guide. No chains, no algorithm.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17120f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;0,800;0,900;1,700&family=Special+Elite&family=Inter:wght@400;600&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip" href="#main">Skip to places</a>
    <slot />
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
  </body>
</html>
