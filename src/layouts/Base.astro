---
import '../styles/global.css';
import Header from '../components/Header.astro';
import SignupDialog from '../components/SignupDialog.astro';
// The two fonts the first screen needs, preloaded so the headline paints in its real face (self-hosted, see tokens.css)
import displayFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import uiFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
interface Props { title: string; description?: string; image?: string; path?: string; metro?: string }
const { title, description = 'Hole-in-the-wall guide to the Bay Area, San Diego and Portland. No chains, no algorithm.', image, path = '/', metro } = Astro.props;
// Absolute URLs are needed for share previews. Set `site` in astro.config.mjs once the domain is known.
const origin = Astro.site?.origin ?? Astro.url.origin;
const pageUrl = new URL(path, origin).href;
const imageUrl = image ? new URL(image, origin).href : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#000000" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={pageUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="The Unlisted" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={uiFont} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <script is:inline>
      // Welcome gate: shown once, on a first visit to the front page (or with ?gate=1 to see it again).
      // Arriving any other way, like a shared link to a place, counts as already in.
      // The js class lets styles hold back things that animate in (they stay visible without scripts).
      document.documentElement.classList.add('js');
      try {
        if (location.pathname === '/' && /[?&]gate=1/.test(location.search)) document.documentElement.setAttribute('data-gate', '');
        else if (!localStorage.getItem('unlisted:entered')) {
          if (location.pathname === '/' && !location.hash) document.documentElement.setAttribute('data-gate', '');
          else localStorage.setItem('unlisted:entered', 'link');
        }
      } catch (e) {}
    </script>
    <!-- Anonymous visit counts for Dan (pages, time, links off the site; never buttons, lists or anything typed):
         the same script as www.icarianforge.com, explained on /privacy/ -->
    <script is:inline src="/insights.js" data-endpoint="https://www.icarianforge.com/api/i" data-clicks="outbound" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Header metro={metro} />
    <slot />
    <SignupDialog />
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <!-- roughens the edges of the rubber stamp, like ink on paper -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <filter id="ink-edge"><feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" result="n" /><feDisplacementMap in="SourceGraphic" in2="n" scale="3" /></filter>
    </svg>
    <script>
      import '../scripts/tips.js';
      import '../scripts/signup.js';
    </script>
  </body>
</html>
