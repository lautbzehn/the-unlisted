---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
---
<Base title="Locked door — The Unlisted" description="This page doesn't exist." path="/404">
  <main id="main" class="doc" style="text-align:center">
    <header class="bill">
      <div class="stars" aria-hidden="true">★ ★ ★ &nbsp;NO ENTRY&nbsp; ★ ★ ★</div>
      <h1><span class="logo" style="display:block">Locked</span></h1>
      <p class="sub">This door doesn’t open</p>
    </header>
    <p class="lede" style="margin-top:28px">The page you knocked on isn’t here. Maybe it moved, maybe it never existed. The good doors are this way.</p>
    <p style="margin-top:24px"><a class="btn-primary" href="/explore/">Back to all doors</a></p>
    <Footer />
  </main>
</Base>
