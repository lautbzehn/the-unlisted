---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { TURNSTILE_SITE_KEY } from '../lib/config.js';
---
<Base title="Next cities — The Unlisted" description="San Diego, Austin and New York are next. Vote for the city after that, or suggest your own." path="/cities/">
  <main id="main" class="doc cities-page">
    <a class="back" href="/">← All doors</a>

    <section class="undercard" aria-labelledby="coming" style="margin-top:8px">
      <h2 id="coming">★ Next on the card ★</h2>
      <div class="cities" data-coming>
        <span class="city">San Diego</span><span class="vs" aria-hidden="true">&amp;</span>
        <span class="city">Austin</span><span class="vs" aria-hidden="true">&amp;</span>
        <span class="city">New York</span>
      </div>
      <p>Already booked. Help us pick the one after that.</p>
    </section>

    <h1 class="sect" style="margin-top:44px">The undercard</h1>
    <p class="sub">Vote for the cities you want next, one vote per city. New suggestions show up after a quick human check.</p>

    <div class="panel proof">
      <p class="proof-label">Quick check that you’re not a bot (usually just a tick)</p>
      <div id="bot-check" data-sitekey={TURNSTILE_SITE_KEY}></div>
    </div>

    <p class="status" id="status" role="status" aria-live="polite"></p>

    <ol class="board" id="board" aria-label="Cities ranked by votes">
      <li class="board-loading">Loading the board…</li>
    </ol>

    <h2 class="sect">Suggest a city</h2>
    <form class="suggest panel" id="suggest" novalidate>
      <div class="suggest-fields">
        <label>City <input name="name" required maxlength="60" autocomplete="address-level2" placeholder="Chicago" /></label>
        <label>State or country <span class="opt">(optional)</span> <input name="region" maxlength="60" autocomplete="address-level1" placeholder="IL" /></label>
      </div>
      <button class="btn-primary" type="submit">Suggest it</button>
      <p class="privacy">We never store your IP address. We keep a scrambled fingerprint of it so each person gets one vote per city and a few suggestions a day.</p>
    </form>

    <Footer />
  </main>
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <script>
    import '../scripts/cities.js';
  </script>
</Base>
