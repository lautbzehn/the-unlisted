---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import { TURNSTILE_SITE_KEY } from '../lib/config.js';
import CITY_OPTIONS from '../data/city-options.json';
import NeonSign from '../components/NeonSign.astro';

const groups = Object.entries(Object.groupBy(CITY_OPTIONS, (c) => c.group));
---
<Base title="Next cities — The Unlisted" description="The Bay Area, San Diego and Portland are open. Austin and New York are next. Vote for the city after that." path="/cities/">
  <main id="main" class="doc cities-page">
    <header class="page-head">
      <p class="kicker mono">The passport</p>
      <h1 class="page-title">Cities</h1>
      <p class="page-sub">The Bay Area, San Diego and Portland are <strong class="go-text">open</strong>. Here’s what comes next, and where you can vote for the city after that.</p>
    </header>

    <section class="coming" aria-labelledby="coming">
      <h2 id="coming" class="eyebrow">Opening next</h2>
      <div class="sign-wall">
        <p class="signs"><NeonSign id="austin" name="Austin" /><span class="sr-only"> and </span><NeonSign id="new-york" name="New York" /></p>
      </div>
      <p>Already booked. <a class="go-text" href="/san-diego/">San Diego</a> and <a class="go-text" href="/portland/">Portland</a> are open.</p>
    </section>

    <h2 class="sect">Vote for the next city</h2>
    <p class="sub">One vote per city. The most-wanted cities get researched first.</p>

    <p class="status" id="status" role="status" aria-live="polite"></p>
    <!-- Cloudflare's bot check. Invisible for most people; it only appears here if it needs a tap. -->
    <div id="bot-check" class="bot-check" data-sitekey={TURNSTILE_SITE_KEY}></div>

    <ol class="board" id="board" aria-label="Cities ranked by votes">
      <li class="board-loading">Loading the board…</li>
    </ol>

    <h2 class="sect">Add a city</h2>
    <form class="suggest panel form" id="suggest" novalidate>
      <label for="city-pick">Pick a city</label>
      <div class="suggest-row">
        <select id="city-pick" name="slug" required>
          <option value="">Choose a city…</option>
          {groups.map(([group, cities]) => (
            <optgroup label={group}>
              {cities.map((c) => <option value={c.slug}>{c.name}, {c.region}</option>)}
            </optgroup>
          ))}
        </select>
        <button class="btn btn-primary" type="submit">Add and vote</button>
      </div>
      <p class="privacy">Cities already on the board are voted on above. We never store your IP address; a scrambled fingerprint keeps it to one vote per city.</p>
    </form>
  </main>
  <Footer />
  <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" async defer></script>
  <script>
    import '../scripts/cities.js';
  </script>
</Base>
