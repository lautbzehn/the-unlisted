---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import BrowseRow from '../components/BrowseRow.astro';
import SurpriseDialog from '../components/SurpriseDialog.astro';
import Gate from '../components/Gate.astro';
import { places, slim, topHoods } from '../lib/places.js';

const MIN = 3; // a row needs at least this many places to be worth showing
const by = (f) => places.filter(f);
const NOW_ROWS = [
  { bucket: 'morning', title: 'Morning doors', sub: 'Coffee, pastries and breakfast counters that open early.' },
  { bucket: 'midday', title: 'Lunch doors', sub: 'Counters and kitchens worth the detour at lunch.' },
  { bucket: 'evening', title: 'Dinner doors', sub: 'Where to eat tonight.' },
  { bucket: 'late', title: 'Late-night doors', sub: 'Usually open past 10. Check before you go.' },
].map((r) => ({ ...r, list: by((p) => p.when?.includes(r.bucket)) })).filter((r) => r.list.length >= MIN);
// The second row: deep cuts once there are enough of them, local legends until then.
const deep = by((p) => p.fame === 'deep-cut');
const second = deep.length >= MIN
  ? { id: 'deep', title: 'Deep cuts', sub: 'Barely written about anywhere. You heard it from someone, not a website.', list: deep, fame: 'deep-cut' }
  : { id: 'legends', title: 'Local legends', sub: 'Decades in, still the real thing.', list: by((p) => p.fame === 'local-legend'), fame: 'local-legend' };
const hoods = topHoods(places, 12);
---
<Base title="The Unlisted — Bay Area hole-in-the-wall guide">
  <Gate />
  <main id="main" class="home">
    <section class="cover">
      <h1 class="logo">The Unlisted</h1>
      <p class="tagline">Places you only hear about from <span class="redact" aria-hidden="true">the cousin who</span><span class="sr-only">someone who</span> knows a guy.</p>
      <div class="cover-cta">
        <button id="surprise-btn" class="btn btn-primary btn-lg" type="button">Surprise me</button>
        <a class="btn btn-lg" href="/explore/">Explore all {places.length}</a>
      </div>
    </section>

    <SurpriseDialog />

    {NOW_ROWS.map((r) => (
      <BrowseRow id={`now-${r.bucket}`} bucket={r.bucket} kicker="Right now" title={r.title} sub={r.sub}
        places={r.list} total={r.list.length} seeAll={`/explore/?time=${r.bucket}`} hidden />
    ))}
    <noscript><style>.browse[data-bucket='midday'] { display: block !important; }</style></noscript>

    {second.list.length >= MIN && (
      <BrowseRow id={second.id} title={second.title} sub={second.sub} places={second.list} total={second.list.length} seeAll={`/explore/?fame=${second.fame}`} />
    )}

    <section class="browse" aria-labelledby="by-hood">
      <div class="browse-head">
        <h2 id="by-hood">Pick a neighborhood</h2>
        <a class="more-link" href="/explore/">All of them →</a>
      </div>
      <ul class="hood-chips" role="list">
        {hoods.map((h) => (
          <li><a href={`/explore/?where=${h.where}`}>{h.label}{h.city !== 'San Francisco' && `, ${h.city}`}<span class="n">{h.n}</span></a></li>
        ))}
      </ul>
    </section>

    <section class="next-cities" aria-label="Next cities">
      <p><strong>Next stamps in the passport:</strong> San Diego, Austin and New York.</p>
      <a class="more-link" href="/cities/">Vote for the one after →</a>
    </section>

    <script type="application/json" id="places-data" set:html={JSON.stringify(slim(places))} />
  </main>
  <Footer sample={places.some((p) => p.sample)} />

  <script>
    import '../scripts/home.js';
    import '../scripts/gate.js';
  </script>
</Base>
