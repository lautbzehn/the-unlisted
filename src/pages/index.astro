---
import Base from '../layouts/Base.astro';
import PlaceCard from '../components/PlaceCard.astro';
import places from '../data/places.json';
---
<Base title="The Unlisted — Bay Area hole-in-the-wall guide">
  <main id="main">
    <header class="door">
      <small>— EST. NOWHERE —</small>
      <h1 class="logo">The <i>Unlisted</i></h1>
      <div class="rule"></div>
      <p class="tag">Bay Area hole-in-the-wall guide. Knock twice.</p>
      <div class="fine">NO CHAINS · NO ALGORITHM · NO KIDDING</div>
    </header>

    <form class="search" role="search" onsubmit="return false">
      <label for="vibe">DESCRIBE THE NIGHT YOU WANT</label>
      <div class="field">
        <input id="vibe" type="search" placeholder="A dim, candlelit bar where the bartender makes up drinks…" disabled />
        <button class="btn-primary" type="button" disabled>Find it</button>
      </div>
      <p class="soon">VIBE SEARCH: COMING IN THE NEXT BUILD</p>
    </form>

    <div class="surprise-row">
      <button id="surprise-btn" class="btn-primary big" type="button">Surprise me</button>
      <p>One door you'd never find, picked for you. Your location stays on your device.</p>
    </div>

    <dialog id="surprise" aria-labelledby="sp-title">
      <div class="sp-card">
        <button class="sp-x" data-sp="close" aria-label="Close">×</button>
        <div class="sp-kicker">TONIGHT'S DOOR</div>
        <div class="sp-slot" data-sp="slot" aria-hidden="true"></div>
        <div class="sp-body">
          <div class="stamp" aria-hidden="true"><div>GEM<br /><b data-sp="score"></b></div></div>
          <span class="sample-flag" data-sp="sample">SAMPLE — NOT A REAL PLACE</span>
          <h2 id="sp-title"></h2>
          <div class="meta" data-sp="meta"></div>
          <p data-sp="story"></p>
          <div class="order"><span>ORDER THIS</span><div data-sp="order"></div></div>
          <p class="sp-where" data-sp="where"></p>
          <div class="sp-actions">
            <a class="btn-primary" data-sp="open" href="#">Open the file →</a>
            <a class="btn-ghost" data-sp="directions" href="#" target="_blank" rel="noopener">Directions</a>
            <button class="btn-ghost" data-sp="knock" aria-pressed="false">Knock Later</button>
            <button class="btn-ghost" data-sp="map">Show on map</button>
            <button class="btn-ghost" data-sp="again">Another one</button>
          </div>
        </div>
      </div>
    </dialog>

    <div class="toolbar">
      <div class="tabs" role="group" aria-label="Show">
        <button class="tab" data-filter="all" aria-pressed="true">All doors <span class="n">(0)</span></button>
        <button class="tab" data-filter="knock" aria-pressed="false">Knock List <span class="n">(0)</span></button>
        <button class="tab" data-filter="ledger" aria-pressed="false">The Ledger <span class="n">(0)</span></button>
      </div>
      <div class="views" role="group" aria-label="View">
        <button class="tab" data-view="cards" aria-pressed="true">Cards</button>
        <button class="tab" data-view="map" aria-pressed="false">Map</button>
      </div>
    </div>

    <p class="empty" id="empty" role="status"></p>
    <div id="map-wrap" hidden>
      <div id="map" role="region" aria-label="Map of places. Use the pins, or switch to Cards for a list."></div>
      <ul class="legend" aria-hidden="true">
        <li><span class="swatch" data-status="none"></span>Undiscovered</li>
        <li><span class="swatch" data-status="knock"></span>Knock List</li>
        <li><span class="swatch" data-status="ledger"></span>In your Ledger</li>
      </ul>
    </div>
    <script type="application/json" id="places-data" set:html={JSON.stringify(places)} />
    <section class="grid" aria-label="Places">
      {places.map((p) => <PlaceCard place={p} />)}
    </section>

    <footer>
      <p>HUMAN CURATED · AI ENRICHED · SAMPLE DATA SHOWN</p>
    </footer>
  </main>

  <script>
    import '../scripts/shelves.js';
  </script>
</Base>
