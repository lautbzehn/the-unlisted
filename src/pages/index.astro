---
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import PlaceCard from '../components/PlaceCard.astro';
import { places } from '../lib/places.js';
---
<Base title="The Unlisted — Bay Area hole-in-the-wall guide">
  <main id="main">
    <header class="bill">
      <div class="crest" aria-hidden="true">U</div>
      <h1 class="logo">The Unlisted</h1>
      <p class="sub">Passport · Bay Area · All hours</p>
      <p class="fine">Places you only hear about from <span class="redact" aria-hidden="true">the cousin who</span><span class="sr-only">someone who</span> knows a guy.</p>
    </header>

    <form class="search" role="search" onsubmit="return false">
      <label for="vibe">Describe what you’re in the mood for</label>
      <div class="field">
        <input id="vibe" type="search" placeholder="A counter-seat diner that does breakfast right…" disabled />
        <button class="btn-primary" type="button" disabled aria-label="Find it"><span class="long">Find it</span><span class="short" aria-hidden="true">→</span></button>
      </div>
      <p class="soon">Vibe search: coming in the next build</p>
    </form>

    <div class="surprise-row">
      <button id="surprise-btn" class="btn-primary big" type="button">Surprise me</button>
      <p>One door, picked for you, any hour. Your location stays on your device.</p>
    </div>

    <dialog id="surprise" aria-labelledby="sp-title">
      <div class="sp-card">
        <button class="sp-x" data-sp="close" aria-label="Close">×</button>
        <div class="sp-kicker">TODAY'S DOOR</div>
        <div class="sp-slot" data-sp="slot" aria-hidden="true"></div>
        <div class="sp-body">
          <div class="stamp" aria-hidden="true"><small>GEM</small><b data-sp="score"></b><i>VISA</i></div>
          <span class="sample-flag" data-sp="sample">SAMPLE — NOT A REAL PLACE</span>
          <h2 id="sp-title"></h2>
          <div class="meta" data-sp="meta"></div>
          <p data-sp="story"></p>
          <p class="order"><em>Order</em><span data-sp="order"></span></p>
          <p class="sp-where" data-sp="where"></p>
          <div class="sp-actions">
            <a class="btn-primary" data-sp="open" href="#">Open the file →</a>
            <a class="btn-ghost" data-sp="directions" href="#" target="_blank" rel="noopener">Directions</a>
            <button class="btn-ghost" data-sp="knock" aria-pressed="false">+ Bucket List</button>
            <button class="btn-ghost" data-sp="map">Show on map</button>
            <button class="btn-ghost" data-sp="again">Another one</button>
          </div>
        </div>
      </div>
    </dialog>

    <div class="toolbar" id="places">
      <div class="tabs" role="group" aria-label="Show">
        <button class="tab" data-filter="all" aria-pressed="true">All<span class="long"> doors</span> <span class="n">(0)</span></button>
        <button class="tab" data-filter="knock" aria-pressed="false" data-tip="Places you want to go.">Bucket<span class="long"> List</span> <span class="n">(0)</span></button>
        <button class="tab" data-filter="ledger" aria-pressed="false" data-tip="Places you’ve been and stamped.">Stamped <span class="n">(0)</span></button>
      </div>
      <div class="views" role="group" aria-label="View">
        <button class="tab" data-view="cards" aria-pressed="true">Cards</button>
        <button class="tab" data-view="map" aria-pressed="false">Map</button>
      </div>
    </div>

    <div class="whenbar" role="group" aria-label="Time of day">
      <span class="whenlabel" aria-hidden="true">WHEN</span>
      <button class="tab" data-time="any" aria-pressed="true">Any time <span class="n"></span></button>
      <button class="tab" data-time="now" aria-pressed="false">Right now: <span class="now-label"></span> <span class="n"></span></button>
      <button class="tab" data-time="morning" aria-pressed="false">Morning <span class="n"></span></button>
      <button class="tab" data-time="midday" aria-pressed="false">Midday <span class="n"></span></button>
      <button class="tab" data-time="evening" aria-pressed="false">Evening <span class="n"></span></button>
      <button class="tab" data-time="late" aria-pressed="false">Late <span class="n"></span></button>
    </div>

    <p class="empty" id="empty" role="status"></p>
    <div id="map-wrap" hidden>
      <div id="map" role="region" aria-label="Map of places. Use the pins, or switch to Cards for a list."></div>
      <ul class="legend" aria-hidden="true">
        <li><span class="swatch" data-status="none"></span>Not on your lists</li>
        <li><span class="swatch" data-status="knock"></span>Bucket List</li>
        <li><span class="swatch" data-status="ledger"></span>Stamped</li>
      </ul>
    </div>
    <script type="application/json" id="places-data" set:html={JSON.stringify(places)} />
    <section class="grid" aria-label="Places">
      {places.map((p) => <PlaceCard place={p} />)}
    </section>

    <section class="undercard" aria-labelledby="next-on-card">
      <h2 id="next-on-card">Next stamps in the passport</h2>
      <div class="cities">
        <span class="city">San Diego</span><span class="vs" aria-hidden="true">·</span>
        <span class="city">Austin</span><span class="vs" aria-hidden="true">·</span>
        <span class="city">New York</span>
      </div>
      <p>Bay Area only for now. These three are next.</p>
      <a class="more" href="/cities/">Vote for the city after that →</a>
    </section>

    <Footer sample={places.some((p) => p.sample)} />
  </main>

  <script>
    import '../scripts/shelves.js';
  </script>
</Base>
