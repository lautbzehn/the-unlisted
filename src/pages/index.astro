---
import Base from '../layouts/Base.astro';
import PlaceCard from '../components/PlaceCard.astro';
import places from '../data/places.json';
---
<Base title="The Unlisted — Bay Area hole-in-the-wall guide">
  <main id="main">
    <header class="door">
      <small>— EST. NOWHERE —</small>
      <h1 class="logo">The <i>Unlisted</i></h1>
      <div class="rule"></div>
      <p class="tag">Bay Area hole-in-the-wall guide. Knock twice.</p>
      <div class="fine">NO CHAINS · NO ALGORITHM · NO KIDDING</div>
    </header>

    <form class="search" role="search" onsubmit="return false">
      <label for="vibe">DESCRIBE THE NIGHT YOU WANT</label>
      <div class="field">
        <input id="vibe" type="search" placeholder="A dim, candlelit bar where the bartender makes up drinks…" disabled />
        <button class="btn-primary" type="button" disabled>Find it</button>
      </div>
      <p class="soon">VIBE SEARCH: COMING IN THE NEXT BUILD</p>
    </form>

    <div class="tabs" role="group" aria-label="Show">
      <button class="tab" data-filter="all" aria-pressed="true">All doors <span class="n">(0)</span></button>
      <button class="tab" data-filter="knock" aria-pressed="false">Knock List <span class="n">(0)</span></button>
      <button class="tab" data-filter="ledger" aria-pressed="false">The Ledger <span class="n">(0)</span></button>
    </div>

    <p class="empty" id="empty" role="status"></p>
    <section class="grid" aria-label="Places">
      {places.map((p) => <PlaceCard place={p} />)}
    </section>

    <footer>
      <p>HUMAN CURATED · AI ENRICHED · SAMPLE DATA SHOWN</p>
    </footer>
  </main>

  <script>
    import '../scripts/shelves.js';
  </script>
</Base>
