---
import Base from '../../layouts/Base.astro';
import Footer from '../../components/Footer.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import MapSheet from '../../components/MapSheet.astro';
import { places } from '../../lib/places.js';

export function getStaticPaths() {
  return places.map((place) => ({ params: { id: place.id }, props: { place } }));
}
const { place } = Astro.props;
const description = `${place.kind} in ${place.area}. ${place.story}`;
---
<Base
  title={`${place.name} — The Unlisted`}
  description={description}
  image={`/og/${place.id}.png`}
  path={`/place/${place.id}/`}
>
  <main id="main" class="place-page">
    <a class="back" href="/explore/">← Explore</a>
    <PlaceCard place={place} variant="detail" />
    <MapSheet />
  </main>
  <Footer sample={place.sample} />
  <script>
    import '../../scripts/passport.js';
    import { openSheet } from '../../scripts/mapsheet.js';
    document.addEventListener('click', (e) => {
      if (!e.target.closest('[data-action=map]')) return;
      openSheet(e.target.closest('.card'));
    });
  </script>
</Base>
