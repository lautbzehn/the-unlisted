// Cloudflare settings for publishing. `npm run deploy` builds the site and uploads ./dist.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "the-unlisted",
  "compatibility_date": "2026-10-01",
  // Small server program for /api/* (city board: list, vote, suggest). Everything else is the static site.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "the-unlisted", "database_id": "7b436fed-18be-482e-9130-3f5aaadad833", "migrations_dir": "migrations" }
  ],
  // Lets the site email Dan about new messages and place tips. The address is the NOTIFY_TO secret, so it stays out of the code;
  // Cloudflare only delivers to addresses verified in Email Routing.
  "send_email": [{ "name": "EMAIL" }],
  // Serves the site at this address and creates its DNS record on icarianforge.com automatically.
  "routes": [{ "pattern": "unlisted.icarianforge.com", "custom_domain": true }]
  // Secrets (not in this file): TURNSTILE_SECRET and NOTIFY_TO, set with `wrangler secret put`.
}
